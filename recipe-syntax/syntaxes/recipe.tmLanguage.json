{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Recipe",
  "scopeName": "source.recipe",
  "patterns": [
    {
      "name": "markup.strikethrough.double-tilde.recipe",
      "match": "^\\s*~~.*$"
    },
    {
      "name": "markup.bold.recipe",
      "begin": "\\*\\*",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.bold.begin.recipe" }
      },
      "end": "\\*\\*",
      "endCaptures": {
        "0": { "name": "punctuation.definition.bold.end.recipe" }
      }
    },
    {
      "name": "markup.italic.recipe",
      "begin": "(?<!\\*)\\*(?!\\*)",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.italic.begin.recipe" }
      },
      "end": "(?<!\\*)\\*(?!\\*)",
      "endCaptures": {
        "0": { "name": "punctuation.definition.italic.end.recipe" }
      }
    },
    {
      "name": "punctuation.separator.pipe.recipe",
      "match": "\\|"
    },
    {
      "name": "comment.line.annotation.recipe",
      "match": "(?<=\\|).*$"
    },
    {
      "name": "meta.ingredient.identifier.recipe",
      "match": "^\\s*(!)([^|\\[\\{\\r\\n]+)",
      "captures": {
        "1": { "name": "keyword.operator.identifier.recipe" },
        "2": { "name": "entity.name.tag.ingredient.recipe" }
      }
    },
    {
      "name": "meta.item-identifier.recipe",
      "match": "\\{([0-9]+)\\}",
      "captures": {
        "0": { "name": "meta.item-identifier.recipe" },
        "1": { "name": "constant.numeric.item-id.recipe" }
      }
    },
    {
      "name": "meta.bracket.quantity.recipe",
      "begin": "\\[",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.bracket.open.recipe" }
      },
      "end": "\\]",
      "endCaptures": {
        "0": { "name": "punctuation.definition.bracket.close.recipe" }
      },
      "patterns": [
        {
          "name": "keyword.other.unit.recipe",
          "match": "[0-9]+(?:\\.[0-9]+)?\\s*(?:oz|tbsp|tsp|g|kg|lbs?|cups?|cloves?|pinch|can|bag|bunch)?"
        }
      ]
    },
    {
      "name": "entity.name.tag.ingredient.recipe",
      "match": "^(?:(?!~~)[^\\|\\[\\{\r\n])+"
    }
  ]
}